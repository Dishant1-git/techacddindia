# Copy this file to .env.local and fill in your own value.
# .env.local is git-ignored — never commit the real URL.

# SheetDB endpoint for the lead sheet.
# Create one at https://sheetdb.io -> "Create new API" -> paste your Google Sheet URL.
# It looks like: https://sheetdb.io/api/v1/abc123xyz
SHEETDB_URL=
